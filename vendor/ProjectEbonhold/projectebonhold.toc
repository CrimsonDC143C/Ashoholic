# Skill Tree's frame (previously loaded early, standalone) now creates itself
# directly as a native child of CollectionsJournal's Skill Tree tab -- moved
# here so CollectionsJournal exists first. TalentDatabase/skillTree_service/
# skillTreeDebug stay in their original early slot (pure data/service, no
# frame creation, nothing here depends on their exact load position).
modules\skillTree\skillTree.lua
modules\skillTree\skillTreeMicroButton.lua

# Prestige: skill tree reset meta-progression (Prestige tab of /progression).
# Data and service are frame-free; the UI creates EbonholdPrestigeFrame as a
# native child of CollectionsJournal (same pattern as skillTree.lua), so all
# three load after the Collections shell and before character_progression.lua
# (which creates the hub tab that embeds it).
modules\prestige\prestige_data.lua
# GENERATED: the "Additional Unlock" class sets of milestones 3..12 (Tier 3,
# vanilla PvP, arena Seasons 1-8), attached onto the Milestones table. Must
# load right after prestige_data.lua.
modules\prestige\prestige_data_sets.lua
# Chat rank badge: defines CHAT_FLAG_PRESTIGEnn from the rankIcon fields above,
# which is all both FrameXML and ElvUI need to draw it. Must load after
# prestige_data.lua; nothing depends on it in turn.
modules\prestige\prestige_chat.lua
modules\prestige\prestige_service.lua
modules\prestige\prestige.lua

# Character Progression hub: /progression -- ties together Collections, Echo
# Journal, Skill Tree and Prestige under one tabbed launcher. Loaded last so
# all the embedded systems' globals (CollectionsJournal,
# ProjectEbonhold.EchoJournal, skillTreeFrame, EbonholdPrestigeFrame) already
# exist.
modules\progression\character_progression.lua