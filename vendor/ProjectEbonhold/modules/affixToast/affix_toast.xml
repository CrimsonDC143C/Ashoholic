<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
	<!--
		Affix loot toast. Visual kit lifted from pretty_lootalert (s0h2x, MIT) and cut down to two
		looks: the plain loot toast (affix already owned) and the legendary toast (affix the player
		does not own yet). Textures/sounds live in assets\loottoast\. Logic is in affix_toast.lua.
	-->
	<Button name="EbonholdAffixToastTemplate" parent="UIParent" toplevel="true" frameLevel="120" frameStrata="FULLSCREEN_DIALOG" hidden="true" virtual="true">
		<Size x="276" y="96"/>
		<Animations>
			<AnimationGroup parentKey="animIn">
				<Alpha change="0" duration="0" order="1"/>
				<Alpha change="1" duration="0.2" order="2"/>
				<Scripts>
					<OnFinished>
						-- held on screen while the first-affix tour points at it
						local toast = self:GetParent()
						if not toast.holdForTour then toast.waitAndAnimOut:Play() end
					</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="waitAndAnimOut">
				<Alpha startDelay="5" change="-1" duration="1.5" parentKey="animOut">
					<Scripts>
						<OnFinished>
							self:GetParent():GetParent():Hide()
						</OnFinished>
					</Scripts>
				</Alpha>
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\loottoast" hidden="false">
					<Size x="276" y="96"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0.28222656" right="0.55175781" top="0.57812500" bottom="0.95312500"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="LegendaryBackground" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\LegendaryToast" hidden="true">
					<Size x="302" y="119"/>
					<Anchors>
						<Anchor point="CENTER" x="-12" y="-4"/>
					</Anchors>
					<TexCoords left="0.396484" right="0.986328" top="0.00195312" bottom="0.234375"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentIcon" parentKey="Icon">
					<Size x="52" y="52"/>
					<Anchors>
						<Anchor point="LEFT" x="23" y="-2"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentCount" parentKey="Count" inherits="NumberFontNormal" justifyH="RIGHT">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentIcon" x="-2" y="3"/>
					</Anchors>
				</FontString>
				<Texture parentKey="IconBorder" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\LootToastAtlas">
					<Size x="58" y="58"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentIcon" relativePoint="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.34082" right="0.397461" top="0.53125" bottom="0.644531"/>
				</Texture>
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="180" y="14"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="7" y="4"/>
					</Anchors>
				</FontString>
				<FontString parentKey="ItemName" inherits="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE">
					<Size x="180" y="26"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="9" y="-10"/>
					</Anchors>
				</FontString>
				<FontString parentKey="AffixName" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Size x="180" y="14"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="9" y="-37"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Hint" inherits="GameFontNormalSmall" justifyH="LEFT" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="9" y="-51"/>
					</Anchors>
				</FontString>
				<Texture parentKey="legendaryGlow" alpha="0" alphaMode="ADD" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\LegendaryToast">
					<Size x="302" y="119"/>
					<Anchors>
						<Anchor point="CENTER" x="-12" y="-4"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="1" duration="0.5" order="1"/>
							<Alpha change="-1" duration="0.5" order="2"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
					<TexCoords left="0.396484" right="0.986328" top="0.00195312" bottom="0.234375"/>
				</Texture>
				<Texture parentKey="legendaryShine" alpha="0" alphaMode="ADD" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\LegendaryToast">
					<Size x="302" y="119"/>
					<Anchors>
						<Anchor point="CENTER" x="-12" y="-4"/>
					</Anchors>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="1" duration="0.5" order="1"/>
							<Alpha change="-1" duration="0.5" order="2"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
					<TexCoords left="0.396484" right="0.986328" top="0.00195312" bottom="0.234375"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="glow" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\LootToastAtlas" alphaMode="ADD" hidden="true">
					<Size x="286" y="109"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.000976562" right="0.280273" top="0.00195312" bottom="0.214844"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="-1" duration="0" order="1"/>
							<Alpha change="1" duration="0.2" order="2"/>
							<Alpha change="-1" duration="0.5" order="3"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
				</Texture>
				<Texture parentKey="shine" file="Interface\AddOns\ProjectEbonhold\assets\loottoast\LootToastAtlas" alphaMode="ADD" hidden="true">
					<Size x="171" y="75"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-10" y="12"/>
					</Anchors>
					<TexCoords left="0.817383" right="0.984375" top="0.21875" bottom="0.365234"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="-1" duration="0" order="1"/>
							<Alpha change="1" duration="0.1" order="2"/>
							<Translation offsetX="200" offsetY="0" duration="0.71" order="3"/>
							<Alpha change="-1" duration="0.25" startDelay="0.175" order="3"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="EbonholdAffixToast_OnLoad"/>
			<OnShow function="EbonholdAffixToast_OnShow"/>
			<OnHide function="EbonholdAffixToast_OnHide"/>
			<OnClick function="EbonholdAffixToast_OnClick"/>
			<OnEnter function="EbonholdAffixToast_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

	<Frame name="EbonholdAffixToastFrame" parent="UIParent" hidden="false">
		<Size x="10" y="10"/>
		<Anchors>
			<Anchor point="BOTTOM" x="0" y="128"/>
		</Anchors>
		<Scripts>
			<OnLoad function="EbonholdAffixToastFrame_OnLoad"/>
			<OnEvent function="EbonholdAffixToastFrame_OnEvent"/>
			<OnUpdate function="EbonholdAffixToastFrame_OnUpdate"/>
		</Scripts>
	</Frame>

	<Button name="EbonholdAffixToast1" inherits="EbonholdAffixToastTemplate" id="1"/>
	<Button name="EbonholdAffixToast2" inherits="EbonholdAffixToastTemplate" id="2"/>
	<Button name="EbonholdAffixToast3" inherits="EbonholdAffixToastTemplate" id="3"/>
	<Button name="EbonholdAffixToast4" inherits="EbonholdAffixToastTemplate" id="4"/>
</Ui>
