<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.blizzard.com/wow/ui/">
	<Script file="AccountSummary.lua"></Script>

	<Button name="AltoCharacterSummaryTemplate" virtual="true">
		<Size><AbsDimension x="670" y="22"/></Size>
		<HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
		
		<!-- Scripts moved to the Master Row Button -->
		<Scripts>
			<OnLoad>self:RegisterForClicks("LeftButtonDown", "RightButtonDown");</OnLoad>
			<OnClick>Altoholic.Summary:Row_OnClick(self, button)</OnClick>
			<OnEnter>Altoholic.Summary:Row_OnEnter(self)</OnEnter>
			<OnLeave>AltoTooltip:Hide();</OnLeave>
		</Scripts>
		
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentSelection" file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD" hidden="true">
					<Size x="667" y="22"/>
					<Anchors><Anchor point="LEFT"><Offset x="2" y="0"/></Anchor></Anchors>
				</Texture>
				
				<Texture name="$parentLineV0" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="2" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>
				<Texture name="$parentLineV1" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="140" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>
				<Texture name="$parentLineV2" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="185" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>
				<Texture name="$parentLineV3" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="285" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>
				<Texture name="$parentLineV4" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="395" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>
				<Texture name="$parentLineV5" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="530" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>
				<Texture name="$parentLineV6" hidden="false"><Size x="1" y="22"/><Anchors><Anchor point="LEFT"><Offset x="668" y="0"/></Anchor></Anchors><Color r="0.4" g="0.4" b="0.4" a="0.3"/></Texture>

				<FontString name="$parentLevel" inherits="GameFontNormalSmall" justifyH="CENTER">
					<Size x="45" y="18"/>
					<Anchors><Anchor point="TOPLEFT"><Offset x="140" y="0"/></Anchor></Anchors>
				</FontString>
				
				<FontString name="$parentWT10" inherits="GameFontNormalSmall" justifyH="CENTER">
					<Size x="50" y="18"/>
					<Anchors><Anchor point="TOPLEFT"><Offset x="185" y="0"/></Anchor></Anchors>
				</FontString>
				<FontString name="$parentWT25" inherits="GameFontNormalSmall" justifyH="CENTER">
					<Size x="50" y="18"/>
					<Anchors><Anchor point="TOPLEFT"><Offset x="235" y="0"/></Anchor></Anchors>
				</FontString>
				
				<FontString name="$parentResetCost" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size x="100" y="18"/>
					<Anchors><Anchor point="TOPLEFT"><Offset x="285" y="0"/></Anchor></Anchors>
					<Color r="255" g="255" b="255" />
				</FontString>
				<FontString name="$parentSoulAsh" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size x="125" y="18"/>
					<Anchors><Anchor point="TOPLEFT"><Offset x="395" y="0"/></Anchor></Anchors>
				</FontString>
				<FontString name="$parentMoney" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size x="130" y="18"/> 
					<Anchors><Anchor point="TOPLEFT"><Offset x="530" y="0"/></Anchor></Anchors>
				</FontString>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentLine" hidden="true">
					<Size x="667" y="1"/>
					<Anchors><Anchor point="TOPLEFT"><Offset x="2" y="0"/></Anchor></Anchors>
					<Color r="0.5" g="0.5" b="0.5" a="0.5"/>
				</Texture>
				<Texture name="$parentLineBottom" hidden="true">
					<Size x="667" y="1"/>
					<Anchors><Anchor point="BOTTOMLEFT"><Offset x="2" y="0"/></Anchor></Anchors>
					<Color r="0.5" g="0.5" b="0.5" a="0.5"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCollapse" hidden="true">
				<Size><AbsDimension x="16" y="16"/></Size>
				<Anchors><Anchor point="LEFT"><Offset x="2" y="0"/></Anchor></Anchors>
				<Scripts>
					<OnClick>
						Altoholic.Characters:ToggleHeader(self)
						Altoholic.Summary:Update()
					</OnClick>
				</Scripts>
				<NormalTexture name="$parentIcon" file="Interface\Buttons\UI-MinusButton-UP" />
				<HighlightTexture file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD" />
			</Button>
			
			<!-- Converted to Frame so it doesn't intercept the Mouse clicks from the master row -->
			<Frame name="$parentName">
				<Size><AbsDimension x="120" y="18"/></Size>
				<Anchors><Anchor point="TOPLEFT"><Offset x="20" y="0"/></Anchor></Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parentNormalText" inherits="GameFontNormalSmallLeft" justifyH="LEFT">
							<Size><AbsDimension x="120" y="18"/></Size>
							<Anchors><Anchor point="LEFT"><Offset x="0" y="0"/></Anchor></Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Button>

	<Frame name="AltoholicFrameSummary" parent="AltoholicTabSummary" enableMouse="true">
		<Size><AbsDimension x="690" y="250"/></Size>
		<Anchors><Anchor point="TOPLEFT"><Offset x="0" y="-39"/></Anchor></Anchors>
		<Scripts>
			<OnMouseDown>
				Altoholic.SelectedLine = nil
				if Altoholic.Summary then Altoholic.Summary:Update() end
			</OnMouseDown>
		</Scripts>
		<Frames>
			<ScrollFrame name="$parentScrollFrame" inherits="FauxScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" />
					<Anchor point="BOTTOMRIGHT" />
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
							<Size><AbsDimension x="31" y="256"/></Size>
							<Anchors><Anchor point="TOPLEFT" relativePoint="TOPRIGHT"><Offset x="-2" y="5"/></Anchor></Anchors>
							<TexCoords left="0" right="0.484375" top="0" bottom="1.0"/>
						</Texture>
						<Texture file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
							<Size><AbsDimension x="31" y="106"/></Size>
							<Anchors><Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT"><Offset x="-2" y="0"/></Anchor></Anchors>
							<TexCoords left="0.515625" right="1.0" top="0" bottom="0.4140625"/>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnVerticalScroll>
						FauxScrollFrame_OnVerticalScroll(self, offset, 18, Altoholic.Summary.Update)
					</OnVerticalScroll>
				</Scripts>
			</ScrollFrame>
			
			<Button name="$parentEntry1" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentScrollFrame" relativePoint="TOPLEFT" /></Anchors></Button>
			<Button name="$parentEntry2" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry1" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry3" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry2" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry4" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry3" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry5" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry4" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry6" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry5" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry7" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry6" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry8" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry7" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry9" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry8" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry10" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry9" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry11" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry10" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry12" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry11" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry13" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry12" relativePoint="BOTTOMLEFT" /></Anchors></Button>
			<Button name="$parentEntry14" inherits="AltoCharacterSummaryTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentEntry13" relativePoint="BOTTOMLEFT" /></Anchors></Button>
		
			<Frame name="$parentRightClickMenu" inherits="UIDropDownMenuTemplate" id="1" hidden="true">
				<Size><AbsDimension x="100" y="40"/></Size>
				<Scripts><OnLoad>UIDropDownMenu_Initialize(self, Altoholic.Summary.RightClickMenu_OnLoad, "MENU");</OnLoad></Scripts>
			</Frame>
		</Frames>
	</Frame>
</Ui>